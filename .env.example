# Copy this file to .env and fill it in. Bun loads .env automatically.
# Never commit .env or spotify-tokens.json — both are gitignored.

# Spotify app credentials: create a free app at
# https://developer.spotify.com/dashboard, then add this redirect URI to
# the app's settings (used by `bun run auth`):
#   http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional overrides (defaults shown):
# PORT=3000
# HOST=127.0.0.1
# POLL_INTERVAL_MS=60000
# TRACKER_DB_FILE=./tracker.db
# TRACKER_TOKENS_FILE=./spotify-tokens.json
# SPOTIFY_REFRESH_TOKEN=
